{
  "name": "geslic-backend",
  "version": "1.0.0",
  "description": "API do GESLIC (Node + Express + MySQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:setup:exemplos": "node scripts/setup-db.js --exemplos",
    "db:reset": "node scripts/setup-db.js --reset"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "mysql2": "3.11.3"
  }
}
