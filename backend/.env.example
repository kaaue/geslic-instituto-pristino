# Copie este arquivo para .env e preencha com os dados do seu ambiente.
# O arquivo .env não vai para o Git: senhas e credenciais ficam só na sua máquina.
# Nenhum valor abaixo é segredo real; troque os de produção.

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
# development (padrão) ou production. Em produção: cookie só em HTTPS,
# e-mail só por SMTP e db:reset bloqueado.
NODE_ENV=development
PORTA=3001
# Endereço da interface: origem aceita pela API e base dos links enviados por e-mail
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# Banco de dados MySQL
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_SENHA=coloque_sua_senha_aqui
DB_NOME=geslic

# ------------------------------------------------------------
# Sessão (cookie HttpOnly; a sessão fica no banco, tabela sessao)
# ------------------------------------------------------------
# Validade máxima a partir do login, em horas
SESSAO_DURACAO_HORAS=8
# Encerra a sessão parada por este tempo, em minutos
SESSAO_INATIVIDADE_MINUTOS=60
# Cookie só por HTTPS. Padrão: true em produção, false em desenvolvimento.
# COOKIE_SEGURO=true

# ------------------------------------------------------------
# Recuperação de senha e limite de tentativas
# ------------------------------------------------------------
# Validade do link enviado por e-mail, em minutos
RECUPERACAO_VALIDADE_MINUTOS=30
# Falhas de login aceitas por conta e por endereço, e pedidos de recuperação
# por endereço, dentro da janela de tempo (minutos)
LIMITE_LOGIN_POR_CONTA=5
LIMITE_LOGIN_POR_IP=20
LIMITE_RECUPERACAO_POR_IP=5
LIMITE_JANELA_MINUTOS=15

# ------------------------------------------------------------
# E-mail (só para a recuperação de senha)
# ------------------------------------------------------------
# smtp     envia de verdade, pelas variáveis SMTP_* abaixo
# console  SÓ DESENVOLVIMENTO: a mensagem (com o link) aparece no terminal da
#          API e NÃO é enviada. Recusado com NODE_ENV=production.
# Vazio: console em desenvolvimento; em produção a recuperação por e-mail
# fica indisponível (a API responde 503) até o SMTP ser configurado.
EMAIL_MODO=console
EMAIL_REMETENTE=GESLIC <nao-responda@pristino.org.br>
SMTP_HOST=
SMTP_PORTA=587
# true para TLS direto (porta 465); false usa STARTTLS na 587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=

# ------------------------------------------------------------
# Contas criadas pelos scripts de banco (db:setup, db:migrate)
# ------------------------------------------------------------
# Senha da conta inicial "admin", usada por db:setup, db:migrate e admin:redefinir.
# geslic123 é a senha fixa de DESENVOLVIMENTO da equipe. Em produção, troque por
# uma senha forte (os scripts recusam senha fraca com NODE_ENV=production) ou
# deixe vazio: o script gera uma senha provisória, mostra uma vez e obriga a
# troca no primeiro acesso.
ADMIN_SENHA=geslic123
ADMIN_EMAIL=admin@pristino.org.br
# Senha dos usuários de teste do "npm run db:setup:exemplos". Só desenvolvimento.
SENHA_USUARIOS_TESTE=Geslic2026
