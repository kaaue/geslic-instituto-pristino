# Copie este arquivo para .env e preencha com os dados do seu MySQL.
# O arquivo .env não vai para o Git, por isso a senha fica só na sua máquina.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_SENHA=coloque_sua_senha_aqui
DB_NOME=geslic

PORTA=3001

# Contas criadas pelo "npm run db:setup" (opcionais).
# Sem ADMIN_SENHA, o setup gera uma senha aleatória para o usuário "admin" e a mostra uma vez.
ADMIN_SENHA=
ADMIN_EMAIL=admin@pristino.org.br
# Senha dos usuários de teste criados pelo "npm run db:setup:exemplos". Só para desenvolvimento.
SENHA_USUARIOS_TESTE=geslic123
